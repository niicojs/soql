{
  "name": "@niicojs/soql",
  "version": "0.2.1",
  "description": "Safe SOQL template literal tag for Salesforce - prevents SOQL injection with automatic escaping",
  "keywords": [
    "apex",
    "escape",
    "force.com",
    "injection",
    "query-builder",
    "salesforce",
    "security",
    "soql",
    "sql",
    "template-literal"
  ],
  "homepage": "https://github.com/niicojs/soql#readme",
  "bugs": {
    "url": "https://github.com/niicojs/soql/issues"
  },
  "license": "MIT",
  "author": "niico",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niicojs/soql.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "build:watch": "vp pack --watch",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "typecheck": "vp check --typecheck",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run check && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0"
}
